<!-- Header Include -->
<%- include('partials/header') %>

<!-- Print & Security Styles -->
<style nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    /* Professional A4 Print Optimization */
    @media print {
        @page { size: A4; margin: 10mm; }
        body { background-color: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .no-print { display: none !important; }
        .card { border: none !important; box-shadow: none !important; margin-top: 0 !important; page-break-inside: avoid; }
        .card-header { background-color: transparent !important; color: #000 !important; border-bottom: 2px solid #000; padding: 0 !important; margin-bottom: 10mm;}
        .print-only-header { display: block !important; text-align: center; margin-bottom: 15px; }
        .table { border-color: #000 !important; }
        .table th, .table td { border-color: #000 !important; padding: 4px 6px !important; font-size: 11px; }
        .badge-success { border: 1px solid #28a745 !important; color: #28a745 !important; background: transparent !important; }
    }
    .print-only-header { display: none; }
    
    /* Authentic Watermark Styling */
    .watermark-container { position: relative; z-index: 1; }
    .rtu-watermark { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.06; width: 400px; z-index: -1; pointer-events: none; }
    
    /* Disabling Text Selection for Extra Security */
    .noselect {
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        -khtml-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }
    
    .no-js-hide { display: block; }
</style>

<!-- Fallback for Disabled JS -->
<noscript>
    <style>
        .no-js-hide { display: none !important; }
    </style>
    <div class="alert alert-danger text-center mt-5" role="alert">
        <i class="fa-solid fa-triangle-exclamation"></i> <strong>JavaScript is required.</strong> Please enable JavaScript to access this secure portal.
    </div>
</noscript>

<!-- Main Content Area Start -->
<div class="container mt-4 mb-5 noselect no-js-hide" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div class="col-lg-11 col-md-12">
            
            <!-- Result Search Form Card (Hides on Print) -->
            <div class="card shadow-lg border-0 no-print mb-4">
                <div class="card-header text-white text-center" style="background-color: #c45f17;">
                    <h3 class="mb-0"><i class="fa-solid fa-shield-halved mr-2"></i> RTU 4-Year Degree Programme Result Portal</h3>
                </div>
                <div class="card-body p-4">
                    
                    <div class="alert alert-info text-center" style="font-size: 14px;">
                        <i class="fa-solid fa-lock text-success"></i> <strong>256-bit Encrypted Connection.</strong> Official Cumulative Transcript Retrieval.
                    </div>

                    <form action="/results" method="POST" id="secureResultForm" onsubmit="return submitSecureForm(this);">
                        
                        <!-- CSRF Token -->
                        <% if (typeof csrfToken !== 'undefined') { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% } %>

                        <div class="form-group mb-3">
                            <label for="roll_no" class="form-label font-weight-bold">Enter Roll Number:</label>
                            <!-- Fixed Reference Safety: Using locals explicitly to prevent ReferenceError -->
                            <input type="text" 
                                   id="roll_no"
                                   name="roll_no" 
                                   class="form-control form-control-lg text-uppercase" 
                                   value="<%= (typeof rollNo !== 'undefined') ? rollNo : (locals.rollNo ? locals.rollNo : '') %>" 
                                   placeholder="e.g. 17EUCEE039" 
                                   maxlength="15" 
                                   pattern="[a-zA-Z0-9]+" 
                                   title="Only alphanumeric characters are allowed"
                                   autocomplete="off" 
                                   spellcheck="false"
                                   oninput="this.value = this.value.toUpperCase()"
                                   required>
                            <small class="form-text text-muted"><i class="fa-solid fa-circle-info"></i> Enter valid University Roll Number (Max 15 characters).</small>
                        </div>

                        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100" style="background-color: #4a148c; border: none; cursor: pointer;">
                            <span id="btnText"><i class="fa-solid fa-magnifying-glass"></i> Retrieve Transcript Securely</span>
                            <span id="btnSpinner" style="display:none;"><i class="fa-solid fa-spinner fa-spin"></i> Fetching Academic Records...</span>
                        </button>
                    </form>

                    <!-- Error Message -->
                    <% if (typeof locals.error !== 'undefined' && locals.error) { %>
                        <div class="alert alert-danger mt-4 text-center font-weight-bold" role="alert" aria-live="assertive">
                            <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Authentic Result Data Display -->
            <% if (typeof locals.result !== 'undefined' && locals.result) { %>
                <div class="card shadow-sm border-dark watermark-container p-3" id="resultPrintArea">
                    
                    <!-- Authentic Watermark -->
                    <img src="/assets/images/RTU-MG150-.png" alt="RTU Watermark" class="rtu-watermark">

                    <!-- Top Utility Bar (No Print) -->
                    <div class="d-flex justify-content-between align-items-center mb-3 no-print border-bottom pb-2">
                        <span class="text-muted font-weight-bold" style="font-size: 13px;"><i class="fa-solid fa-file-shield text-success"></i> Official Cumulative Transcript Verification</span>
                        <button onclick="window.print()" class="btn btn-sm btn-dark" aria-label="Print Transcript"><i class="fa-solid fa-print"></i> Print Official Transcript</button>
                    </div>

                    <div class="card-body p-2 bg-transparent">
                        
                        <!-- Print-Only Official Header -->
                        <div class="print-only-header">
                            <div style="font-size: 12px; font-weight: bold; float: right;">S. No. : <%= result.serial_no || '033119' %></div>
                            <div style="font-size: 11px; font-weight: bold; float: right; clear: right;"><%= result.form_no || '00141' %></div>
                            <h4 style="font-weight: bold; letter-spacing: 0.5px; margin-bottom: 2px;">RAJASTHAN TECHNICAL UNIVERSITY</h4>
                            <div style="font-size: 13px;">Statement of Marks Odalhed at the. &nbsp;&nbsp;&nbsp;&nbsp; Bachelor of Technology</div>
                            <div style="font-size: 12px; margin-top: 5px; font-weight: bold;">(Four Year Degree Programme)</div>
                        </div>

                        <!-- Student Bio Details Grid -->
                        <div class="border border-dark p-3 mb-3 bg-light" style="font-size: 13px; background-color: #fcfcfc !important;">
                            <div class="row">
                                <div class="col-md-7 col-sm-12">
                                    <table class="table table-sm table-borderless mb-0 bg-transparent">
                                        <tr><th width="35%" class="pl-0 py-1">Roll No.</th><td class="py-1">: <strong><%= result.roll_no %></strong></td></tr>
                                        <tr><th class="pl-0 py-1">Name of Candidate</th><td class="py-1">: <strong><%= result.student_name %></strong></td></tr>
                                        <tr><th class="pl-0 py-1">Father's Name</th><td class="py-1">: <%= result.father_name || 'N/A' %></td></tr>
                                        <tr><th class="pl-0 py-1">Mother's Name</th><td class="py-1">: <%= result.mother_name || 'N/A' %></td></tr>
                                        <tr><th class="pl-0 py-1">Name of College</th><td class="py-1">: <%= result.college_name || 'UNIVERSITY DEPARTMENT, RAJASTHAN TECHNICAL UNIVERSITY, KOTA' %></td></tr>
                                    </table>
                                </div>
                                <div class="col-md-5 col-sm-12">
                                    <table class="table table-sm table-borderless mb-0 bg-transparent">
                                        <tr><th width="45%" class="pl-0 py-1">Enrollment No.</th><td class="py-1">: <%= result.enrollment_no %></td></tr>
                                        <tr><th class="pl-0 py-1">Year of Admission</th><td class="py-1">: <%= result.year_of_admission || '2017' %></td></tr>
                                        <tr><th class="pl-0 py-1">Completion Year</th><td class="py-1">: <%= result.year_of_completion || '2021' %></td></tr>
                                        <tr><th class="pl-0 py-1">Branch</th><td class="py-1">: <strong><%= result.branch || result.course %></strong></td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- 4-Year Semester Wise Consolidated Marks Table -->
                        <div class="table-responsive">
                            <table class="table table-bordered text-center bg-transparent" style="font-size: 12px; vertical-align: middle;">
                                <thead style="background-color: #e9ecef;">
                                    <tr>
                                        <th rowspan="2" class="align-middle" width="18%">EXAMINATION</th>
                                        <th colspan="4" class="text-center">Max. Marks</th>
                                        <th colspan="4" class="text-center">Marks Obtained</th>
                                    </tr>
                                    <tr>
                                        <th width="10%">Theory</th>
                                        <th width="10%">Practical</th>
                                        <th width="8%">DECA</th>
                                        <th width="10%">TOTAL</th>
                                        <th width="10%">Theory</th>
                                        <th width="10%">Practical</th>
                                        <th width="8%">DECA</th>
                                        <th width="14%">TOTAL</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (result.semesters && result.semesters.length > 0) { %>
                                        <% result.semesters.forEach(function(sem) { %>
                                            <tr>
                                                <td class="font-weight-bold text-left pl-2"><%= sem.exam_name %></td>
                                                <td><%= sem.max_theory %></td>
                                                <td><%= sem.max_practical %></td>
                                                <td><%= sem.max_deca !== null && sem.max_deca !== '' ? sem.max_deca : '--' %></td>
                                                <td class="font-weight-bold"><%= sem.max_total %></td>
                                                <td><%= sem.obt_theory %></td>
                                                <td><%= sem.obt_practical %></td>
                                                <td><%= sem.obt_deca !== null && sem.obt_deca !== '' ? sem.obt_deca : '--' %></td>
                                                <td class="font-weight-bold"><%= sem.obt_total %></td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="9" class="text-muted text-center py-3">No semester records available.</td>
                                        </tr>
                                    <% } %>

                                    <!-- Grand Total Row -->
                                    <tr style="background-color: #f1f3f5; font-weight: bold;">
                                        <td class="text-left pl-2">GRAND TOTAL</td>
                                        <td colspan="3"></td>
                                        <td><%= result.grand_max_total || '10100' %></td>
                                        <td colspan="3"></td>
                                        <td class="text-primary" style="font-size: 13px;"><%= result.grand_obt_total || '6290' %></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Result / Division Section -->
                        <div class="border border-dark text-center py-2 mb-3 bg-light" style="background-color: #f8f9fa !important;">
                            <div style="font-size: 12px; font-weight: bold; letter-spacing: 1px;">RESULT / DIVISION</div>
                            <div style="font-size: 16px; font-weight: bold; color: #000; margin-top: 2px;"><%= result.division || 'FIRST' %></div>
                        </div>

                        <!-- Official Guidelines & Rules Note -->
                        <div class="text-muted mb-3" style="font-size: 9.5px; line-height: 1.3;">
                            <strong>NOTE:</strong> (The brief guidelines given below are only indicative. For detail, the corresponding Order/Notification/Regulation issued from time to time must be referred).<br>
                            1. Minimum passing marks: in each Theory paper 33% in Final Examination and 40% in aggregate of Term Test and Final Examination AND in Practical & Sessional 30% in each component separately and 80% in aggregate of both components taken together.<br>
                            2. A candidate will be awarded: a. honour: if he/she secures atleast 70% of the aggregate. b. First Class: if he/she secures atleast 60% of the aggregate. c. Second Division: if he/she secures atleast 60% of the aggregate. d. Pass Division: if he/she secures below 60% subject to fulfillment of condition at point no.1.<br>
                            3. University reserves the right to correct the corrected (revised) Marks Sheet, if any mistake is found in the original Marks Sheet at any stage of period.<br>
                            4. All runt usket oneill he s ultiam te the gutcrinbon of the Rajasthan Technical University headquarters i.e. KOTA and not any other place.<br>
                            5. Medium of instruction of the programme is English only.<br>
                            6. Formula for conversion of percentage into CGPA = (Percentage/16) * 6.76.
                        </div>

                        <!-- Footer Signatures & Date -->
                        <div class="row align-items-end mt-4 pt-2" style="font-size: 11px;">
                            <div class="col-6">
                                <div><strong>KOTA</strong> &nbsp;&nbsp;&nbsp; Date: <strong><%= result.issue_date || '14/07/2022' %></strong></div>
                            </div>
                            <div class="col-6 text-right">
                                <div style="font-family: monospace; font-size: 14px; font-weight: bold; margin-bottom: -5px;">Prlhm</div>
                                <div style="border-top: 1px solid #000; display: inline-block; padding-top: 2px; width: 220px; text-align: center;">
                                    <strong>Prof. Dhirendra Melhuri</strong><br>
                                    <span style="font-size: 10px;">Controller of Examinations</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            <% } %>

        </div>
    </div>
</div>

<!-- Scripts Secured by CSP Nonce Engine -->
<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    function submitSecureForm(form) {
        document.getElementById('btnText').style.display = 'none';
        document.getElementById('btnSpinner').style.display = 'inline';
        document.getElementById('submitBtn').disabled = true;
        setTimeout(() => { form.submit(); }, 100);
        return false; 
    }

    // Anti-Snooping Defense
    document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
    document.onkeydown = function(e) {
        if (e.keyCode === 123 || (e.ctrlKey && e.shiftKey && (e.keyCode === 73 || e.keyCode === 74)) || (e.ctrlKey && e.keyCode === 85)) {
            e.preventDefault();
            return false;
        }
    };
</script>
<!-- Main Content Area End -->

<!-- Footer Include -->
<%- include('partials/footer') %>